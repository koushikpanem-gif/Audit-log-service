{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-log.invalid/schemas/bundle.schema.json",
  "title": "audit-export-bundle/v1",
  "description": "Small signed export bundle. signature = Ed25519(JCS(this object without its top-level signature)), standard Base64. recordsDigest = SHA-256 hex of JCS(records) with no domain prefix. Cross-field rules (digest, count, order, bounds, hashes, selection matching) are enforced by the verifier and are listed in docs/export-bundles.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "bundleId", "purpose", "ledgerId", "hashAlgorithm", "hashVersion", "genesisHash", "signatureAlgorithm", "exportedAt", "exportedBy", "selection", "completeness", "recordCount", "recordsDigest", "records", "headCheckpoint", "signer", "signature"],
  "properties": {
    "format": {"const": "audit-export-bundle/v1"},
    "bundleId": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["EXPORT", "RETENTION_ARCHIVE", "COMPLIANCE_REPORT"]},
    "ledgerId": {"type": "string", "minLength": 1},
    "hashAlgorithm": {"const": "SHA-256"},
    "hashVersion": {"const": 1},
    "genesisHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signatureAlgorithm": {"const": "Ed25519"},
    "exportedAt": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
    "exportedBy": {"type": "string", "minLength": 1},
    "selection": {"$ref": "selection.schema.json"},
    "completeness": {"$ref": "completeness.schema.json"},
    "recordCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "recordsDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {"type": "array", "items": {"$ref": "record.schema.json"}},
    "headCheckpoint": {"$ref": "checkpoint.schema.json"},
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "publicKey"],
      "properties": {
        "keyId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}
      }
    },
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
